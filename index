    // App State
    let speakersData = [];
    let currentSelectedId = null;

    // Load Data
    function loadData() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          speakersData = JSON.parse(stored);
        } else {
          speakersData = [...INITIAL_SEED_DATA];
          saveData();
        }
      } catch (e) {
        console.error('Failed to load localStorage', e);
        speakersData = [...INITIAL_SEED_DATA];
      }
      updateUI();
    }

    // Save Data
    function saveData() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(speakersData));
      } catch (e) {
        console.error('Failed to save localStorage', e);
      }
    }


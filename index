          <pre class="text-[11px] font-mono overflow-x-auto text-softpink-200 bg-slate-950 p-3 rounded-lg leading-relaxed">// 1. ดึงการตั้งค่าจากแท็บ 'setting' ไปแสดงที่ Web App
function doGet(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("setting");
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({ error: "No setting sheet" }))
      .setMimeType(ContentService.MimeType.JSON);
  }
  var lastRow = sheet.getRange("A:A").getValues().filter(String).length;
  var classrooms = lastRow > 1 ? sheet.getRange(2, 1, lastRow - 1, 1).getValues().flat() : [];
  var pwd = sheet.getRange("C2").getValue() || "admin1234";

  return ContentService.createTextOutput(JSON.stringify({
    classrooms: classrooms,
    adminPassword: pwd.toString()
  })).setMimeType(ContentService.MimeType.JSON);
}

// 2. บันทึกคำตอบจากผู้ปกครองลงในแท็บ 'responses'
function doPost(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("responses") || ss.getActiveSheet();
  var data = JSON.parse(e.postData.contents);
  sheet.appendRow([
    new Date(),
    data.classroom,
    data.studentName,
    data.parentName,
    data.relationship,
    data.occupation,
    data.organization,
    data.phone,
    data.topicTitle,
    data.categories.join(', '),
    data.summary,
    data.preferredDays,
    data.location
  ]);
  return ContentService.createTextOutput("OK");
}</pre>

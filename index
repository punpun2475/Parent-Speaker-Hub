    function populateClassroomFilter() {
      const filterClass = document.getElementById('filter-class');
      const currentVal = filterClass.value;
      const uniqueClasses = Array.from(new Set(speakersData.map(s => s.classroom))).filter(Boolean).sort();

      filterClass.innerHTML = '<option value="">-- ทุกห้องเรียน --</option>';
      uniqueClasses.forEach(cls => {
        const opt = document.createElement('option');
        opt.value = cls;
        opt.textContent = `ห้อง ${cls}`;
        filterClass.appendChild(opt);
      });
      filterClass.value = currentVal;
    }

    // Render Metrics
    function renderMetrics() {
      const total = speakersData.length;
      const uniqueClasses = new Set(speakersData.map(s => s.classroom)).size;
      const scheduledCount = speakersData.filter(s => s.status === 'นัดหมายแล้ว' || s.status === 'จัดกิจกรรมแล้ว').length;

      // Count top category
      const catCount = {};
      speakersData.forEach(s => {
        if (Array.isArray(s.categories)) {
          s.categories.forEach(c => {
            const shortC = c.split(' ')[0];
            catCount[shortC] = (catCount[shortC] || 0) + 1;
          });
        }
      });
      let topCat = '-';
      let maxC = 0;
      for (const [k, v] of Object.entries(catCount)) {
        if (v > maxC) {
          maxC = v;
          topCat = k;
        }
      }

      document.getElementById('stat-total').textContent = total;
      document.getElementById('stat-classes').textContent = uniqueClasses;
      document.getElementById('stat-scheduled').textContent = scheduledCount;
      document.getElementById('stat-top-cat').textContent = topCat;
      document.getElementById('badge-count').textContent = total;
    }


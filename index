              </label>
              <input type="text" id="organization" name="organization" placeholder="เช่น บจก. เทคโนโลยีล้ำสมัย / ธุรกิจคลินิกแพทย์" class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm focus:border-softpink-500 focus:outline-none focus:ring-2 focus:ring-softpink-500/20">

    document.getElementById('speaker-survey-form').addEventListener('submit', (e) => {
      e.preventDefault();

      // Collect categories
      const selectedCats = [];
      document.querySelectorAll('input[name="categories"]:checked').forEach(cb => {
        selectedCats.push(cb.value);
      });

      const customCat = document.getElementById('custom-category').value.trim();
      if (customCat) {
        selectedCats.push(customCat);
      }

      if (selectedCats.length === 0) {
        showToast('กรุณาเลือกหมวดหมู่วิชาชีพ/ทักษะอย่างน้อย 1 ข้อ');
        return;
      }

      const now = new Date();
      const dateStr = now.toLocaleDateString('th-TH') + ' ' + now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });

      const newEntry = {
        id: 'spk-' + Date.now().toString(36),
        classroom: document.getElementById('classroom').value,
        studentName: document.getElementById('student-name').value.trim(),
                parentName: document.getElementById('parent-name').value.trim(),
        relationship: document.getElementById('relationship').value,
        occupation: document.getElementById('occupation').value.trim(),
        organization: document.getElementById('organization').value.trim(),
        phone: document.getElementById('phone').value.trim(),
        topicTitle: document.getElementById('topic-title').value.trim(),
        categories: selectedCats,
        summary: document.getElementById('summary').value.trim(),
        preferredDays: document.getElementById('preferred-days').value.trim(),
        location: document.getElementById('location').value,
        status: 'รอประสานงาน',
        createdAt: dateStr
      };

      speakersData.unshift(newEntry);
      saveData();

      // Send to Google Sheets if configured
      if (sheetWebhookUrl && sheetWebhookUrl.startsWith('http')) {
        try {
          fetch(sheetWebhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newEntry)
          }).catch(err => console.log('Sheet sync note:', err));
        } catch (err) {
          console.error(err);
        }
      }

      // Reset form
      document.getElementById('speaker-survey-form').reset();
      showToast('ส่งข้อมูลแบบลงทะเบียนสำเร็จ! ขอบคุณที่ร่วมแบ่งปันความรู้');


    document.getElementById('filter-class').addEventListener('change', renderDashboard);
    document.getElementById('filter-category').addEventListener('change', renderDashboard);
    document.getElementById('filter-status').addEventListener('change', renderDashboard);
    document.getElementById('filter-keyword').addEventListener('input', renderDashboard);

    // Export CSV
    document.getElementById('btn-export-csv').addEventListener('click', () => {
      if (speakersData.length === 0) {
        showToast('ยังไม่มีข้อมูลสำหรับส่งออก');
        return;
      }

      const headers = [
        'ลำดับ',
        'ระดับชั้น/ห้อง',
        'ชื่อนักเรียน',
        'ชื่อผู้ปกครอง',
        'ความสัมพันธ์',
        'อาชีพ/ตำแหน่งงาน',
        'หน่วยงาน/บริษัท',
        'เบอร์โทรศัพท์',
        'ชื่อหัวข้อการบรรยาย',
        'หมวดหมู่วิชาชีพ',
        'สรุปเนื้อหาย่อ',
        'วันเวลาที่สะดวก',
        'สถานที่',
        'สถานะการประสานงาน',
        'วันที่ลงทะเบียน'
      ];

      const rows = speakersData.map((item, idx) => [
        idx + 1,
        `"${item.classroom || ''}"`,
        `"${item.studentName || ''}"`,
        `"${item.parentName || ''}"`,
        `"${item.relationship || ''}"`,
        `"${item.occupation || ''}"`,
        `"${item.organization || ''}"`,
        `"${item.phone || ''}"`,
        `"${(item.topicTitle || '').replace(/"/g, '""')}"`,
        `"${(Array.isArray(item.categories) ? item.categories.join(', ') : '').replace(/"/g, '""')}"`,
        `"${(item.summary || '').replace(/"/g, '""')}"`,
        `"${(item.preferredDays || '').replace(/"/g, '""')}"`,
        `"${item.location || ''}"`,
        `"${item.status || ''}"`,
        `"${item.createdAt || ''}"`
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `parent_speakers_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('ส่งออกไฟล์ CSV สำเร็จ');
    });

    // Seed Demo Data Button
    document.getElementById('btn-seed-data').addEventListener('click', () => {
      speakersData = [...INITIAL_SEED_DATA];
      saveData();
      renderDashboard();
      showToast('โหลดข้อมูลตัวอย่าง 5 รายการเรียบร้อย');
    });

    // Update UI initial
    function updateUI() {
      renderMetrics();
      renderDashboard();
    }

    // Initialize
    // Google Sheet Integration Logic
    const SHEET_URL_KEY = 'spc_parent_sheet_url_v1';
    let sheetWebhookUrl = '';

    const btnSheetConfig = document.getElementById('btn-sheet-config');
    const sheetConfigModal = document.getElementById('sheet-config-modal');
    const sheetModalCloseBtn = document.getElementById('sheet-modal-close-btn');
    const sheetWebhookInput = document.getElementById('sheet-webhook-url');
    const btnSaveSheetUrl = document.getElementById('btn-save-sheet-url');
    const btnClearSheetUrl = document.getElementById('btn-clear-sheet-url');
    const sheetStatusDot = document.getElementById('sheet-status-dot');
    const sheetStatusText = document.getElementById('sheet-status-text');

    function loadSheetConfig() {
      try {
        sheetWebhookUrl = localStorage.getItem(SHEET_URL_KEY) || '';
        sheetWebhookInput.value = sheetWebhookUrl;
        updateSheetStatusUI();
      } catch (e) {
        console.error(e);
      }
    }

    function updateSheetStatusUI() {
      if (sheetWebhookUrl && sheetWebhookUrl.startsWith('http')) {
        sheetStatusDot.className = 'w-2 h-2 rounded-full bg-softpink-500 ml-0.5 animate-pulse';
        sheetStatusText.className = 'text-xs font-bold text-softpink-700 bg-softpink-50 px-2.5 py-1 rounded-lg border border-softpink-300';
        sheetStatusText.textContent = 'เชื่อมต่อแล้ว (Real-time Sync Active)';
      } else {
        sheetStatusDot.className = 'w-2 h-2 rounded-full bg-slate-300 ml-0.5';
        sheetStatusText.className = 'text-xs font-bold text-slate-500 bg-white px-2.5 py-1 rounded-lg border border-slate-200';
        sheetStatusText.textContent = 'ยังไม่ได้ระบุ Webhook URL (เก็บข้อมูลในเครื่อง)';
      }
    }

    btnSheetConfig.addEventListener('click', () => {
      sheetConfigModal.classList.remove('hidden');
    });

    sheetModalCloseBtn.addEventListener('click', () => {
      sheetConfigModal.classList.add('hidden');
    });

    btnSaveSheetUrl.addEventListener('click', () => {
      sheetWebhookUrl = sheetWebhookInput.value.trim();
      try {
        localStorage.setItem(SHEET_URL_KEY, sheetWebhookUrl);
      } catch (e) {}
      updateSheetStatusUI();
      sheetConfigModal.classList.add('hidden');
      showToast('บันทึกการตั้งค่า Google Sheet เรียบร้อย');
    });

    btnClearSheetUrl.addEventListener('click', () => {
      sheetWebhookUrl = '';
      sheetWebhookInput.value = '';
      try {
        localStorage.removeItem(SHEET_URL_KEY);
      } catch (e) {}
      updateSheetStatusUI();
      showToast('ล้างการเชื่อมต่อ Google Sheet แล้ว');
    });

    const btnSyncSetting = document.getElementById('btn-sync-setting');
    btnSyncSetting.addEventListener('click', async () => {
      const url = sheetWebhookInput.value.trim();
      if (!url || !url.startsWith('http')) {
        showToast('กรุณากรอก Google Apps Script Web App URL ก่อน');
        return;
      }
      showToast('กำลังดึงข้อมูลการตั้งค่าจากแท็บ setting...');
      try {
        const resp = await fetch(url);
        const data = await resp.json();
        if (data.classrooms && data.classrooms.length > 0) {
          // Update classroom select dropdown
          const classroomSelect = document.getElementById('classroom');
          classroomSelect.innerHTML = '<option value="" disabled selected>-- เลือกระดับชั้นและห้องเรียน --</option>';
          data.classrooms.forEach(cls => {
            if (cls) {
              const opt = document.createElement('option');
              opt.value = cls;
              opt.textContent = cls;
              classroomSelect.appendChild(opt);
            }
          });
          // Update admin password if provided
          if (data.adminPassword) {
            ADMIN_PASSWORD_HASH = data.adminPassword;
          }
          showToast(`ซิงค์ห้องเรียนสำเร็จ (${data.classrooms.length} ห้อง)`);
        } else {
          showToast('เชื่อมต่อสำเร็จ แต่ยังไม่มีข้อมูลในคอลัมน์ A ของแท็บ setting');
        }
      } catch (err) {
        console.error(err);
        showToast('ไม่สามารถเชื่อมต่อได้โดยตรง (อาจติดสิทธิ์เข้าถึง หรือให้ตรวจสอบการ Deploy เป็น Anyone)');
      }
    });

    loadSheetConfig();
    loadData();
  </script>
</body>
</html>
